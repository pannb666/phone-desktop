<Window x:Class="PhoneDesktop.Drawer.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneDesktopDrawer"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="#FF0D0E12"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="TileStyle" TargetType="Border">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="126" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- 全屏背景：点击空白区域关闭抽屉 -->
        <Border x:Name="Backdrop"
                Background="#FF0D0E12"
                MouseLeftButtonDown="OnBackdropMouseDown" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部搜索框 -->
            <Border x:Name="SearchPanel"
                    Grid.Row="0"
                    Width="620"
                    Height="54"
                    Margin="0,44,0,22"
                    HorizontalAlignment="Center"
                    CornerRadius="27"
                    Background="#16FFFFFF"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#8CFFFFFF"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />

                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox"
                                 Margin="12,0,20,0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F2F2F5"
                                 CaretBrush="#F2F2F5"
                                 FontSize="15"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Margin="14,0,20,0"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="#73FFFFFF"
                                   IsHitTestVisible="False"
                                   Text="搜索应用、文件或路径…" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 应用网格 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="Scroller"
                              Padding="44,0,44,56"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsHost" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TileStyle}"
                                        Tag="{Binding}"
                                        ToolTip="{Binding TargetPath}"
                                        MouseLeftButtonDown="OnTileMouseDown"
                                        MouseLeftButtonUp="OnTileMouseUp"
                                        MouseRightButtonUp="OnTileRightClick">
                                    <StackPanel VerticalAlignment="Center">
                                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding KindGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="#66FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}"
                                                   Width="58"
                                                   Height="58"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,8,0,0"
                                                   FontSize="12"
                                                   Foreground="#E6F2F2F5"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxHeight="32"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 加载中 / 无结果 -->
                <StackPanel x:Name="StatusPanel"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               FontSize="15"
                               Foreground="#8CFFFFFF"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
