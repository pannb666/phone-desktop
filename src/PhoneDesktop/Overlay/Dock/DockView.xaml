<UserControl x:Class="PhoneDesktop.Overlay.Dock.DockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:PhoneDesktop.Overlay.Dock"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="DockButtonStyle" TargetType="Border">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrayButtonStyle" TargetType="Border">
            <Setter Property="Height" Value="52" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExitButtonStyle" TargetType="Border" BasedOn="{StaticResource DockButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FF5F5F" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DockItemTemplate" DataType="{x:Type dock:DockItemViewModel}">
            <Border Style="{StaticResource DockButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{Binding Name}"
                    MouseLeftButtonDown="OnItemMouseDown"
                    MouseMove="OnItemMouseMove"
                    MouseLeftButtonUp="OnItemMouseUp"
                    MouseRightButtonUp="OnItemRightClick">
                <Grid>
                    <TextBlock Text="{Binding Initial}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#B3FFFFFF" />
                    <Image Source="{Binding Icon}"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 运行中的应用：任务栏语义（活跃高亮、最小化变淡、点击切换） -->
        <DataTemplate x:Key="RunningItemTemplate" DataType="{x:Type dock:RunningAppViewModel}">
            <Border Style="{StaticResource DockButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{Binding Tooltip}"
                    MouseLeftButtonUp="OnRunningClick"
                    MouseRightButtonUp="OnRunningRightClick">
                <Grid>
                    <Border x:Name="ActiveBack"
                            Background="#33FFFFFF"
                            CornerRadius="14"
                            Visibility="Collapsed" />
                    <TextBlock Text="{Binding Initial}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#B3FFFFFF" />
                    <Image Source="{Binding Icon}"
                           Width="40"
                           Height="40"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse x:Name="StateDot"
                             Width="6"
                             Height="6"
                             Fill="#CCFFFFFF"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,3" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="ActiveBack" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StateDot" Property="Fill" Value="#FFFFFFFF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter TargetName="StateDot" Property="Fill" Value="#80FFFFFF" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root"
          HorizontalAlignment="Center"
          VerticalAlignment="Bottom"
          Background="Transparent">
        <Border x:Name="DockPill"
                Height="82"
                Padding="12,0"
                CornerRadius="26"
                Background="#8A0E0F14"
                BorderBrush="#3DFFFFFF"
                BorderThickness="1"
                MouseRightButtonUp="OnDockRightClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="TaskManagerButton"
                        Style="{StaticResource DockButtonStyle}"
                        ToolTip="任务管理器"
                        MouseLeftButtonUp="OnTaskManagerClick">
                    <Grid>
                        <TextBlock Text="任"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#B3FFFFFF" />
                        <Image x:Name="TaskManagerIcon"
                               Width="40"
                               Height="40"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <Border x:Name="LeftSeparator" Width="1" Height="34" Margin="8,0" Background="#22FFFFFF" />

                <ItemsControl x:Name="ItemsHost"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource DockItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#80FFFFFF"
                           Text="在应用抽屉中右键固定应用">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel x:Name="RunningGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="1" Height="34" Margin="8,0" Background="#22FFFFFF" />
                    <ItemsControl x:Name="RunningHost"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Running}"
                                  ItemTemplate="{StaticResource RunningItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <Border x:Name="RightSeparator" Width="1" Height="34" Margin="8,0" Background="#22FFFFFF" />
                <Border x:Name="SettingsButton"
                        Style="{StaticResource DockButtonStyle}"
                        ToolTip="设置"
                        MouseLeftButtonUp="OnSettingsClick">
                    <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="#CCFFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel x:Name="TrayGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border x:Name="WifiButton" Style="{StaticResource TrayButtonStyle}"
                            ToolTip="{Binding WifiTooltip}" Tag="wifi" MouseLeftButtonUp="OnTrayClick">
                        <TextBlock Text="{Binding WifiGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#F2FFFFFF"
                                   Opacity="{Binding WifiOpacity}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="BluetoothButton" Style="{StaticResource TrayButtonStyle}"
                            ToolTip="蓝牙" Tag="bluetooth" MouseLeftButtonUp="OnTrayClick">
                        <TextBlock Text="&#xE702;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#E6FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="VolumeButton" Style="{StaticResource TrayButtonStyle}"
                            ToolTip="音量（点击静音）" Tag="volume" MouseLeftButtonUp="OnTrayClick">
                        <TextBlock Text="{Binding VolumeGlyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#E6FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="ImeButton" Style="{StaticResource TrayButtonStyle}"
                            ToolTip="输入法（点击切换）" Tag="ime" MouseLeftButtonUp="OnTrayClick">
                        <TextBlock Text="{Binding ImeText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#F2FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border x:Name="ClockButton" Style="{StaticResource TrayButtonStyle}"
                            Tag="clock" MouseLeftButtonUp="OnTrayClick">
                        <StackPanel VerticalAlignment="Center" Margin="6,0,4,0">
                            <TextBlock Text="{Binding ClockTime}"
                                       FontSize="13"
                                       Foreground="#F2FFFFFF"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ClockDate}"
                                       FontSize="10"
                                       Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="ExitButton"
                        Style="{StaticResource ExitButtonStyle}"
                        ToolTip="右键双击退出"
                        MouseLeftButtonUp="OnExitLeftClick"
                        MouseRightButtonUp="OnExitRightClick">
                    <TextBlock Text="&#xE7E8;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="#E6FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="ExitHint"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,96"
                Padding="12,7"
                CornerRadius="10"
                Background="#F0121216"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="ExitHintText"
                       FontSize="12"
                       FontFamily="Microsoft YaHei UI"
                       Foreground="#FFF2F2F5"
                       Text="再右键一次退出" />
        </Border>
    </Grid>
</UserControl>
